# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=nodir.exambridge.uz,exambridge.uz,www.exambridge.uz

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=satdb
DB_USER=satuser
DB_PASSWORD=strong-password-here
DB_HOST=db
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ─── Stripe (To'lov tizimi) ───────────────────────────────────────────────────
# TEST uchun: sk_test_... / pk_test_...  (haqiqiy pul yechilmaydi)
# PRODUCTION (haqiqiy pul) uchun: sk_live_... / pk_live_...
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# Webhook secret — Stripe Dashboard > Developers > Webhooks > endpoint dan olinadi
# Endpoint URL: https://nodir.exambridge.uz/api/payments/webhook/
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# To'lovdan keyin qaytadigan sayt manzili (localhost EMAS!)
FRONTEND_URL=https://exambridge.uz
# Obuna narxlari (USD cents): $7.99 / $15.99 / $28.99
STRIPE_PRICE_1MONTH=799
STRIPE_PRICE_3MONTH=1599
STRIPE_PRICE_6MONTH=2899

# ─── TestMakon bridge ─────────────────────────────────────────────────────────
TESTMAKON_API_KEY=

# ─── Admin IP Whitelist (bo'sh = hamma kira oladi) ────────────────────────────
ADMIN_IP_WHITELIST=
