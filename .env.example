# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=nodir.exambridge.uz,exambridge.uz,www.exambridge.uz

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=satdb
DB_USER=satuser
DB_PASSWORD=strong-password-here
DB_HOST=db
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Performance / Sig'im ─────────────────────────────────────────────────────
# Hammasi ixtiyoriy — yozilmasa pastdagi standart qiymatlar ishlatiladi.
#
# Parallel so'rovlar soni = GUNICORN_WORKERS × GUNICORN_THREADS
# Standart: workers = min(2×CPU+1, 12), threads = 6  →  eng ko'pi 72 ta parallel
# Diqqat: bu qiymat DB_MAX_CONNECTIONS dan kam bo'lishi SHART (har oqim 1 ulanish).
# GUNICORN_WORKERS=12
# GUNICORN_THREADS=6
# GUNICORN_TIMEOUT=120
# GUNICORN_WORKER_CLASS=gthread     # muammo bo'lsa eskisiga qaytarish: sync

# PostgreSQL ulanishlar limiti (standart 100 — gthread uchun kam)
# DB_MAX_CONNECTIONS=300
# DB_SHARED_BUFFERS=256MB           # serverda RAM ko'p bo'lsa: 1GB / 2GB

# Redis cache hajmi (oldin 256mb edi — kalitlar tez o'chib ketardi)
# REDIS_MAXMEMORY=1gb

# Celery worker soni (writing AI baholash shu yerda ishlaydi)
# CELERY_CONCURRENCY=6

# ─── Speaking ovoz yozuvlari ──────────────────────────────────────────────────
# Necha kundan keyin ovoz fayllari avtomatik o'chsin.
# Transkript, AI izohi va ball QOLADI — faqat ovozning o'zi o'chadi.
# Tozalash har kuni 04:00 da (Toshkent) celery-beat konteyneri orqali bajariladi.
# SPEAKING_AUDIO_RETENTION_DAYS=120

# ─── Security ─────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
